    "test": "vitest run"
  },
  "dependencies": {
    "@komuta/config": "workspace:*",
    "@komuta/money": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.7.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
