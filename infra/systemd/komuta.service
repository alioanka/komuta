# ----------------------------------------------------------------------------
# Komuta — OPTIONAL systemd unit.
#
# Brings the Docker Compose stack up on boot and down on shutdown. This is a
# convenience only: `restart: unless-stopped` on the containers already means
# Docker restarts them after a reboot. Use this if you prefer systemd to own
# the lifecycle (e.g. `systemctl status komuta`).
#
# Install:
#   sudo cp infra/systemd/komuta.service /etc/systemd/system/komuta.service
#   # edit WorkingDirectory below if your checkout is elsewhere
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now komuta
# ----------------------------------------------------------------------------
[Unit]
Description=Komuta production stack (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# <-- Adjust to the absolute path of the repo checkout on this host.
WorkingDirectory=/home/user/komuta
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# Re-run the start command if it fails.
Restart=on-failure
RestartSec=10
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
