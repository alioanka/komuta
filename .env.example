# ----------------------------------------------------------------------------
# Komuta — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable here is documented in CLAUDE.md and /docs/SETUP_CHECKLIST.md.
#
# ⚠️ PRODUCTION (docker compose on the VPS) — the values below default to
# LOCAL DEV. In production you MUST change:
#   NODE_ENV=production
#   APP_URL=https://panora.live
#   API_URL=https://panora.live/api
#   CORS_ORIGIN=https://panora.live
#   NEXT_PUBLIC_API_URL=https://panora.live/api
#   DATABASE_URL=postgresql://komuta:<POSTGRES_PASSWORD>@postgres:5432/komuta?schema=public
#   REDIS_URL=redis://redis:6379
# (inside compose the DB/Redis hosts are the SERVICE NAMES `postgres`/`redis`,
#  never `localhost`). See docs/02_DEPLOYMENT_CONTABO.md.
# ----------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
# Public URL of the web app (used for CORS, links in notifications)
APP_URL=http://localhost:3000
# Public URL of the API
API_URL=http://localhost:4000
# Public API base inlined into the web bundle at BUILD time (compose build arg)
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
API_PORT=4000

# --- Database (PostgreSQL 16) ---
# In docker compose, the postgres container is initialized from these three:
POSTGRES_USER=komuta
POSTGRES_PASSWORD=komuta
POSTGRES_DB=komuta
# Must match the three values above. Host is `postgres` inside compose,
# `localhost` for local dev.
DATABASE_URL=postgresql://komuta:komuta@localhost:5432/komuta?schema=public

# --- Redis 7 (BullMQ queue + cache) ---
# Host is `redis` inside compose, `localhost` for local dev.
REDIS_URL=redis://localhost:6379

# --- Auth / security ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie domain for the refresh-token cookie (e.g. .panora.live). Empty = host-only.
COOKIE_DOMAIN=
# Comma-separated allowlist of web origins for CORS
CORS_ORIGIN=http://localhost:3000

# --- Meta WhatsApp Cloud API ---
# Graph API version (pinned). See Appendix A / docs 04.
META_GRAPH_VERSION=v23.0
META_APP_ID=
# TODO(secret): from Meta app dashboard
META_APP_SECRET=
# A random string you choose; must match the value entered in the Meta webhook UI
META_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token (scopes: whatsapp_business_management,
# whatsapp_business_messaging, whatsapp_business_manage_events)
# TODO(secret): generate via Business Settings → System Users
WHATSAPP_ACCESS_TOKEN=

# --- Telegram alerts ---
# TODO(secret): from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- Operations ---
# Local time (HH:mm) after which missing-revenue alerts fire
REPORTING_CUTOFF_LOCAL=21:00
DEFAULT_TIMEZONE=Europe/Istanbul
# Percent deviation from trailing average that flags an anomaly
ANOMALY_THRESHOLD_PCT=40

# --- Backups ---
# Key used to encrypt nightly pg_dump archives (openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY=change-me-backup-key

# --- Seed (development only) ---
# Initial owner/accountant passwords printed & used by prisma/seed.ts.
SEED_OWNER_EMAIL=ozer@komuta.local
SEED_OWNER_PASSWORD=ChangeMe!Owner1
SEED_ACCOUNTANT_EMAIL=salih@komuta.local
SEED_ACCOUNTANT_PASSWORD=ChangeMe!Salih1
